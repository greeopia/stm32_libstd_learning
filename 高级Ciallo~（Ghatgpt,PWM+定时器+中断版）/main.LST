   1          #include <REGX52.H>
   2          #include "Timer0_init_PWM.h"
   3          #include "NixiePrint.h"
   4          
   5          unsigned char DisplayChar[8];     // 8 位实际显示内容
   6          unsigned char Brightness[8];      // 每位 PWM 亮度 0~50
   7          
   8          unsigned char PWMCount = 0;       // 0~50
   9          unsigned char ScanPos = 0;        // 当前扫描位
  10          
  11          volatile unsigned char SysTick = 0;  // 1ms 时基标志，由定时器置 1
  12          
  13          // 正弦亮度表 0~50，64 点一个完整波浪周期（存 ROM，省 RAM）
  14          unsigned char code SIN_TABLE[64] =
  15          {
  16              25,27,30,32,35,37,39,41,
  17              43,44,46,47,48,49,50,50,
  18              50,50,50,49,48,47,46,44,
  19              43,41,39,37,35,32,30,27,
  20              25,23,20,18,15,13,11, 9,
