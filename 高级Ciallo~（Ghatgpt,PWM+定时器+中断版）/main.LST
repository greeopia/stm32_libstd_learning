  22               0, 0, 0, 1, 2, 3, 4, 6,
  23               7, 9,11,13,15,18,20,23
  24          };
  25          
  26          unsigned int  WavePhase = 0;     // 波浪相位 0~63
  27          unsigned int  ScrollTimer = 0;   // 文字移位计时
  28          
  29          #define WAVE_STEP_MS  2          // 相位步进间隔(ms)：2ms×64 = 128ms 一个波浪
  30          #define SCROLL_MS     200        // 文字每 200ms 左移一位
  31          
  32          char String[] = "Ciallo~";
  33          unsigned char StringIndex = 0;    // 当前取的字符
  34          unsigned char StringLen = sizeof(String)-1;
  35          
  36          //==================== Timer0 = 每 500us 扫描一位 ====================
  37          void Timer0_ISR() interrupt 1
  38          {
  39   1          static unsigned char halfMs = 0;
  40   1      
  41   1          // 500us 重载值 (11.0592 MHz)
  42   1          TH0 = 0xFE;
  43   1          TL0 = 0x0B;
  44   1      
  45   1          //----------------------------------
  46   1          // ★ 消影：关全部位选 + 清段码
  47   1          //----------------------------------
  48   1          P2_4 = 1;
  49   1          P2_3 = 1;
  50   1          P2_2 = 1;
  51   1          P0 = 0x00;
  52   1      
  53   1          // PWM 计数
C51 COMPILER V9.60.0.0   MAIN                                                              08/17/2026 00:57:34 PAGE 2   

  54   1          PWMCount++;
  55   1          if(PWMCount > 50) PWMCount = 0;
  56   1      
  57   1          //----------------------------------
  58   1          // ★ PWM 控制显示
  59   1          //----------------------------------
  60   1          if(PWMCount < Brightness[ScanPos])
  61   1          {
  62   2              // 亮
  63   2              print(ScanPos+1, DisplayChar[ScanPos]);
  64   2          }
  65   1          else
  66   1          {
  67   2              // 灭（段与位已经在最前面清掉）
  68   2          }
  69   1      
  70   1          // 下一位
  71   1          ScanPos++;
  72   1          if(ScanPos >= 8) ScanPos = 0;
  73   1      
  74   1          // 1ms 时基：每 2 次 500us 中断置一次标志
  75   1          if(++halfMs >= 2)
  76   1          {
  77   2              halfMs = 0;
  78   2              SysTick = 1;
  79   2          }
  80   1      }
  81          
  82          //==================== 浪潮亮度 + 文字移位 ====================
  83          void WaveUpdate(void)
  84          {
  85   1          static unsigned int stepTick = 0;
  86   1          unsigned char i;
  87   1      
  88   1          // 波浪相位前进（每 WAVE_STEP_MS 走一步）
  89   1          if(++stepTick >= WAVE_STEP_MS)
  90   1          {
  91   2              stepTick = 0;
  92   2              WavePhase++;
  93   2              if(WavePhase >= 64) WavePhase = 0;
  94   2          }
  95   1      
  96   1          // 8 位亮度 = 正弦波在 8 位上的采样，随相位整体平移 → 浪潮般的明暗流动
  97   1          for(i=0;i<8;i++)
  98   1          {
  99   2              Brightness[i] = SIN_TABLE[(WavePhase + i*8) & 0x3F];
 100   2          }
 101   1      
 102   1          // 文字左移流水
 103   1          if(++ScrollTimer >= SCROLL_MS)
 104   1          {
 105   2              ScrollTimer = 0;
 106   2              for(i=0;i<7;i++)
 107   2                  DisplayChar[i] = DisplayChar[i+1];
 108   2              DisplayChar[7] = String[StringIndex];
 109   2              StringIndex++;
 110   2              if(StringIndex >= StringLen) StringIndex = 0;
 111   2          }
 112   1      }
 113          
 114          
 115          //======================== main =========================================================
C51 COMPILER V9.60.0.0   MAIN                                                              08/17/2026 00:57:34 PAGE 3   

 116          
 117          void main()
 118          {
 119   1          unsigned char i;
 120   1      
 121   1          // 初始填满字符串，亮度从 0 开始由波浪带起
 122   1          for(i=0;i<8;i++)
 123   1          {
 124   2              DisplayChar[i] = String[i % StringLen];
 125   2              Brightness[i] = 0;
 126   2          }
 127   1          StringIndex = 0;
 128   1      
 129   1          Timer0_Init();
 130   1      
 131   1          while(1)
 132   1          {
 133   2              if(SysTick)
 134   2              {
 135   3                  SysTick = 0;
 136   3                  WaveUpdate();
 137   3              }
 138   2          }
 139   1      }
